# Truck Ranch Final QC — environment variables
#
# This app has NO backend, NO database, and NO API keys. It is a static
# client-only React app; all data lives in the browser's localStorage.
# There are no secrets to configure and nothing here is required to run,
# build, or deploy the app.
#
# The one variable below is recognized by the Vite dev/preview server only
# (it has no effect on the production Static deployment, which serves the
# built dist/ folder directly with no server process to bind a port).

# Port for `npm run dev` / `npm run preview` to listen on.
# Optional — defaults to 5173 if unset. Replit sets this automatically
# for workflows/deployments that need it.
PORT=5173
