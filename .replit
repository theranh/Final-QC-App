modules = ["nodejs-20", "python-3.11", "postgresql-16"]
run = "npm run dev"
entrypoint = "src/App.jsx"
hidden = [".config", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[env]
PORT = "5173"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 5002
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 npm run dev"
waitForPort = 5000

[agent]
expertMode = true
integrations = ["javascript_log_in_with_replit:2.0.0", "github:1.0.0", "google-sheet:1.0.0"]

[userenv]

[userenv.shared]
GOOGLE_SHEETS_SPREADSHEET_ID = "1_rosqSejIr6vT-LaupD20X24xDa-NpfSbGdX4DwfhMM"
